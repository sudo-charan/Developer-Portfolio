VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Server-only AI Assistant API Keys (used by Vercel serverless endpoint /api/ask-charan)
# NEVER use VITE_ prefix for these to prevent client bundle exposure
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Server-only Firebase service account JSON used by /api/contact
# Set this in Vercel's server environment; never prefix it with VITE_.
# Alternatively configure all three FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL,
# and FIREBASE_PRIVATE_KEY variables (private key may contain literal \n).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
